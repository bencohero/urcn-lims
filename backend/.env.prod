# ============================================
# Clinical Storage System - Environment Variables
# ============================================

# Application
APP_NAME=Clinical Storage System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_PASSWORD=clinical_admin_password
DATABASE_URL=postgresql+asyncpg://clinical_admin:${POSTGRES_PASSWORD}@localhost:5432/clinical_storage
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# RabbitMQ
# ============================================
RABBITMQ_PASSWORD=rabbitmq_password
RABBITMQ_URL=amqp://clinical:${RABBITMQ_PASSWORD}@localhost:5672/

# ============================================
# MinIO (Object Storage)
# ============================================
MINIO_ROOT_USER=clinical_minio_admin
MINIO_ROOT_PASSWORD=clinical_minio_admin_password
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=your_very_long_and_secure_jwt_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# For RS256, provide paths to RSA keys (optional)
# JWT_PRIVATE_KEY_PATH=/path/to/private_key.pem
# JWT_PUBLIC_KEY_PATH=/path/to/public_key.pem

# ============================================
# Email (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@clinical-storage.com
SMTP_FROM_NAME=Clinical Storage System
SMTP_TLS=true

# ============================================
# Security
# ============================================
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# Business Rules
# ============================================
ACCESS_REQUEST_DEFAULT_DURATION_DAYS=7
ACCESS_REQUEST_MAX_EXTENSION_DAYS=7
APPROVAL_REMINDER_HOURS=24
OVERDUE_ALERT_DELAY_HOURS=12
STORAGE_CAPACITY_WARNING_PERCENT=90
DEFAULT_RETENTION_YEARS=10
