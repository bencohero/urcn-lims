# API base URL — en dev, relative pour passer par le proxy Vite
# En production, remplacer par l'URL du reverse proxy (nginx)
VITE_API_URL=/api/v1

# WebSocket — en dev, le proxy Vite redirige /ws vers notification-service:8004
# En production, remplacer par l'URL du reverse proxy (nginx)
VITE_WS_URL=ws://localhost:3000/ws

# Application
VITE_APP_NAME=Clinical Storage System
VITE_ENABLE_DEVTOOLS=true
